# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública (anon / publishable). Segura en el navegador gracias a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Salta RLS: solo cron y servidor. ¡Nunca en código de cliente!
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Pixelario <recordatorios@tudominio.com>"

# Protege /api/cron/* (Vercel lo envía como Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# URL pública del sitio (links absolutos y Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
